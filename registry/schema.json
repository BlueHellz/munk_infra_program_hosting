{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MunkeeStudioApplicationRegistry",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "updatedAt": { "type": "string" },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "appId",
          "studioCategory",
          "userFacingName",
          "originalUpstreamName",
          "upstreamRepository",
          "pinnedSourceVersion",
          "browserCompatibilityStatus",
          "buildStatus",
          "deployedVersion",
          "manifestLocation",
          "entryPoint",
          "requiredBrowserCapabilities",
          "legalNoticeLocation"
        ],
        "properties": {
          "appId": { "type": "string" },
          "studioCategory": {
            "type": "string",
            "enum": ["editing", "art", "audio", "3d"]
          },
          "userFacingName": { "type": "string" },
          "originalUpstreamName": { "type": "string" },
          "upstreamRepository": { "type": "string" },
          "pinnedSourceVersion": { "type": "string" },
          "browserCompatibilityStatus": {
            "type": "string",
            "enum": [
              "NOT AUDITED",
              "AUDIT COMPLETE",
              "BROWSER BUILD AVAILABLE",
              "BUILD VERIFIED",
              "DEPLOYMENT VERIFIED",
              "INTEGRATION VERIFIED",
              "DESKTOP ONLY / UNVERIFIED",
              "EXPERIMENTAL"
            ]
          },
          "buildStatus": {
            "type": "string",
            "enum": ["UNBUILT", "BUILDING", "BUILD_SUCCESS", "BUILD_FAILED", "UNVERIFIED"]
          },
          "deployedVersion": { "type": "string" },
          "manifestLocation": { "type": "string" },
          "entryPoint": { "type": "string" },
          "requiredBrowserCapabilities": {
            "type": "array",
            "items": { "type": "string" }
          },
          "legalNoticeLocation": { "type": "string" },
          "license": { "type": "string" },
          "brandingPatchPath": { "type": "string" }
        }
      }
    }
  }
}
